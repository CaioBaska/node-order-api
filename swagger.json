{
  "openapi": "3.0.0",
  "info": {
    "title": "Order API",
    "version": "1.0.0"
  },
  "paths": {
    "/order": {
      "post": {
        "summary": "Create Order",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "201": { "description": "Criado" } }
      }
    },
    "/order/{orderId}": {
      "get": { "summary": "Get Order", "parameters": [{ "name": "orderId", "in": "path", "required": true }], "responses": { "200": { "description": "OK" } } },
      "put": { "summary": "Update Order", "parameters": [{ "name": "orderId", "in": "path", "required": true }], "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "Atualizado" } } },
      "delete": { "summary": "Delete Order", "parameters": [{ "name": "orderId", "in": "path", "required": true }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/order/list": {
      "get": { "summary": "List Order", "responses": { "200": { "description": "OK" } } }
    }
  }
}